<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>India Multilingual Tokenizer — Submission</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #111111;
      --canvas: #ffffff;
      --soft: #f5f5f5;
      --charcoal: #39393b;
      --mute: #707072;
      --stone: #9e9ea0;
      --hair: #e5e5e5;
      --sale: #d30005;
      --success: #007d48;
      --info: #1151ff;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; background: var(--ink); color: var(--ink); }
    body {
      font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 400;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }
    .deck { height: 100vh; width: 100vw; position: relative; }
    .slide {
      position: absolute; inset: 0;
      display: none;
      flex-direction: column;
      background: var(--canvas);
      padding: 36px 48px 72px;
      overflow: auto;
    }
    .slide.active { display: flex; }
    .slide.dark { background: var(--ink); color: var(--canvas); }
    .eyebrow {
      font-size: 12px; font-weight: 500; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--mute); margin-bottom: 12px;
    }
    .slide.dark .eyebrow { color: var(--stone); }
    .display {
      font-family: "Bebas Neue", Impact, sans-serif;
      font-size: clamp(48px, 8vw, 88px);
      line-height: 0.92; letter-spacing: 0.01em;
      text-transform: uppercase; font-weight: 400;
      max-width: 14ch;
    }
    .display.tight { max-width: none; }
    h2.section {
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 500; line-height: 1.15;
      letter-spacing: -0.02em;
    }
    p.lead {
      font-size: 16px; line-height: 1.55; color: var(--charcoal);
      max-width: 48rem; margin-top: 14px;
    }
    .slide.dark p.lead { color: var(--stone); }
    .muted { color: var(--mute); font-size: 14px; line-height: 1.5; }
    .slide.dark .muted { color: var(--stone); }

    /* pills / buttons */
    .row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      height: 48px; padding: 0 28px;
      border-radius: 9999px; border: none; cursor: pointer;
      font-family: inherit; font-size: 15px; font-weight: 500;
      text-decoration: none; white-space: nowrap;
      transition: transform .12s ease, background .12s ease;
    }
    .btn:hover { transform: scale(1.02); }
    .btn:active { transform: scale(0.99); }
    .btn-primary { background: var(--ink); color: var(--canvas); }
    .slide.dark .btn-primary { background: var(--canvas); color: var(--ink); }
    .btn-secondary { background: var(--soft); color: var(--ink); }
    .slide.dark .btn-secondary { background: #2a2a2a; color: var(--canvas); }
    .btn-outline {
      background: transparent; color: inherit;
      border: 1.5px solid var(--hair);
    }
    .slide.dark .btn-outline { border-color: #333; color: var(--canvas); }
    .chip {
      display: inline-flex; align-items: center;
      height: 32px; padding: 0 14px; border-radius: 9999px;
      background: var(--soft); color: var(--ink);
      font-size: 13px; font-weight: 500;
    }
    .slide.dark .chip { background: #2a2a2a; color: var(--canvas); }
    .chip-on { background: var(--ink); color: var(--canvas); }
    .slide.dark .chip-on { background: var(--canvas); color: var(--ink); }

    /* layout helpers */
    .grow { flex: 1; display: flex; flex-direction: column; justify-content: center; }
    .spacer { height: 24px; }
    .spacer-sm { height: 12px; }
    .grid-2 { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 28px; align-items: start; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    @media (max-width: 900px) {
      .grid-2, .grid-4, .grid-3 { grid-template-columns: 1fr; }
      .slide { padding: 24px 20px 80px; }
      .display { max-width: none; }
    }

    .card {
      background: var(--soft); border-radius: 0; padding: 20px 22px;
    }
    .slide.dark .card { background: #1a1a1a; }
    .card h3 {
      font-size: 14px; font-weight: 500; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--mute); margin-bottom: 10px;
    }
    .slide.dark .card h3 { color: var(--stone); }
    .card .big {
      font-family: "Bebas Neue", Impact, sans-serif;
      font-size: 42px; line-height: 1; letter-spacing: 0.02em;
    }
    .card p { font-size: 15px; line-height: 1.5; color: var(--charcoal); }
    .slide.dark .card p { color: var(--stone); }
    .card ul { margin: 0; padding-left: 18px; color: var(--charcoal); font-size: 15px; line-height: 1.55; }
    .slide.dark .card ul { color: var(--stone); }
    .card li { margin: 6px 0; }

    table.stats {
      width: 100%; border-collapse: collapse; font-size: 14px;
    }
    table.stats th, table.stats td {
      text-align: left; padding: 12px 10px;
      border-bottom: 1px solid var(--hair);
    }
    .slide.dark table.stats th, .slide.dark table.stats td { border-color: #2a2a2a; }
    table.stats th {
      font-size: 11px; font-weight: 500; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--mute);
    }
    table.stats td.num { font-variant-numeric: tabular-nums; font-weight: 500; }
    table.stats td.good { color: var(--success); font-weight: 600; }
    table.stats tr.total td { font-weight: 600; border-bottom: none; }

    .callout {
      border-left: 3px solid var(--ink); padding: 12px 16px;
      background: var(--soft); margin-top: 16px;
    }
    .slide.dark .callout { border-color: var(--canvas); background: #1a1a1a; }
    .callout strong { font-weight: 600; }

    .score-hero {
      font-family: "Bebas Neue", Impact, sans-serif;
      font-size: clamp(72px, 14vw, 140px);
      line-height: 0.9; letter-spacing: 0.01em;
    }
    .tag-pass {
      display: inline-block; background: var(--success); color: #fff;
      font-size: 12px; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; padding: 6px 12px; border-radius: 9999px;
    }

    /* SVG flow */
    .flow-wrap { width: 100%; margin-top: 18px; }
    .flow-wrap svg { width: 100%; height: auto; display: block; }

    /* nav chrome */
    .chrome {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
      height: 56px; background: var(--canvas);
      border-top: 1px solid var(--hair);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 20px;
    }
    .dots { display: flex; gap: 8px; align-items: center; }
    .dot {
      width: 8px; height: 8px; border-radius: 9999px;
      background: var(--hair); border: none; cursor: pointer; padding: 0;
    }
    .dot.on { background: var(--ink); width: 22px; }
    .chrome .hint { font-size: 12px; color: var(--mute); font-weight: 500; }
    .chrome .nav-btns { display: flex; gap: 8px; }
    .chrome .nav-btns button {
      height: 36px; min-width: 36px; padding: 0 14px;
      border-radius: 9999px; border: none; cursor: pointer;
      background: var(--soft); color: var(--ink);
      font-family: inherit; font-weight: 500; font-size: 14px;
    }
    .chrome .nav-btns button:hover { background: var(--ink); color: var(--canvas); }

    .file-links a {
      color: var(--ink); font-weight: 500; text-decoration: underline;
      text-underline-offset: 3px; font-size: 14px;
    }
    .slide.dark .file-links a { color: var(--canvas); }
    .file-links span { color: var(--mute); margin: 0 8px; font-size: 12px; }

    .mod-step { display: flex; gap: 14px; align-items: flex-start; margin: 10px 0; }
    .mod-num {
      flex: 0 0 32px; height: 32px; border-radius: 9999px;
      background: var(--ink); color: var(--canvas);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 600;
    }
    .mod-step p { font-size: 15px; line-height: 1.5; color: var(--charcoal); }
    .mod-step strong { color: var(--ink); font-weight: 600; }

    .footer-note {
      margin-top: auto; padding-top: 20px;
      font-size: 12px; color: var(--mute); font-weight: 500;
    }

    /* token breakdown chips */
    .tok-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 6px 0 10px; }
    .tok {
      display: inline-flex; align-items: center;
      padding: 4px 10px; border-radius: 9999px;
      font-size: 13px; font-weight: 500; line-height: 1.3;
      max-width: 100%; word-break: break-word;
    }
    .tok-plain { background: #111; color: #fff; }
    .tok-ours-full {
      background: #e8f5ee; color: #007d48; border: 1px solid #007d48;
    }
    .tok-ours-sub {
      background: #fff4e5; color: #9a3412; border: 1px solid #c2410c;
    }
    /* backward-compat alias */
    .tok-ours { background: #e8f5ee; color: #007d48; border: 1px solid #007d48; }
    .tok-word {
      background: #fff; color: var(--ink);
      border: 1px dashed var(--hair);
    }
    .legend { display: flex; flex-wrap: wrap; gap: 10px 16px; margin: 10px 0 14px; align-items: center; }
    .legend .tok { font-size: 12px; }
    .tok-meta {
      font-size: 12px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--mute); min-width: 4.5rem;
    }
    .sample-block {
      background: var(--soft); padding: 16px 18px; margin-bottom: 12px;
    }
    .sample-block h4 {
      font-size: 13px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; margin-bottom: 8px;
    }
    .sample-block .nums {
      font-variant-numeric: tabular-nums; font-size: 13px; font-weight: 600;
      color: var(--ink); margin-left: auto;
    }
    .sample-head {
      display: flex; flex-wrap: wrap; gap: 10px; align-items: baseline;
      margin-bottom: 6px;
    }
    code.inline {
      background: #fff; padding: 1px 6px; font-size: 12.5px; border-radius: 4px;
    }
    .score-jump {
      display: inline-block;
      margin-top: 4px;
      padding: 10px 16px;
      border-radius: 9999px;
      background: #2a2a2a;
      border: 1px solid #555;
      color: #fff;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.4;
    }
    .score-jump strong {
      color: #fff;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  </style>
</head>
