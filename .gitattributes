# Static marimo notebook exports and frontend pages
*.html filter=lfs diff=lfs merge=lfs -text

# Session transcripts (raw jsonl exports)
transcripts/**/*.jsonl filter=lfs diff=lfs merge=lfs -text

# Large tokenizer artifacts (vocab / merges / token lists)
tokenizer.json filter=lfs diff=lfs merge=lfs -text
vocab.json filter=lfs diff=lfs merge=lfs -text
tokens.txt filter=lfs diff=lfs merge=lfs -text

# Corpora (training text)
**/corpus/*.txt filter=lfs diff=lfs merge=lfs -text
corpus/*.txt filter=lfs diff=lfs merge=lfs -text

# Datasets (raw corpora and derived text — large)
datasets/**/*.txt filter=lfs diff=lfs merge=lfs -text
datasets/**/*.md filter=lfs diff=lfs merge=lfs -text
datasets/**/*.json filter=lfs diff=lfs merge=lfs -text
